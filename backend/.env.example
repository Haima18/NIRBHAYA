# NIRBHAYA backend configuration
# Copy this file to backend/.env and edit the values for your environment.
# Never commit backend/.env.

# --- Server ---------------------------------------------------------------
PORT=5000
# Loopback by default. Set to 0.0.0.0 only for intentional LAN access.
NIRBHAYA_HOST=127.0.0.1
DEBUG=False

# A stable, random value is required for persistent sessions. Generate one,
# for example: python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, the app generates an ephemeral key at startup and signs
# everyone out whenever the backend restarts.
SECRET_KEY=

# SQLite account database. Defaults to backend/nirbhaya_accounts.sqlite3.
# AUTH_DATABASE=C:\path\to\nirbhaya_accounts.sqlite3

# Set to True when the app is served over HTTPS. Keep False for local HTTP.
SESSION_COOKIE_SECURE=False

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Password recovery ----------------------------------------------------
# Email delivery is NOT implemented. When EXPOSE_DEV_RESET_TOKEN=True, the
# forgot-password response includes the reset token for local development.
# Set this to False and connect an email provider before any public deployment.
RESET_TOKEN_TTL_MINUTES=30
EXPOSE_DEV_RESET_TOKEN=False

# --- Optional external AI ------------------------------------------------
# With no keys, the AI Assistant uses the local rule-based safety engine.
# Keys stay on the server and are never sent to the browser. The signed-in
# account must also enable AI processing consent.
#
# [DEMO] Get a FREE Google Gemini API key at https://aistudio.google.com
# Steps: Sign in with Google → "Get API key" → "Create API key" → copy it here.
# The free tier (Gemini 1.5 Flash) is sufficient for this demo with no billing required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional external deepfake detector ---------------------------------
# No detector is bundled. This build records whether a URL is configured but
# does not transmit media to it. Leave empty unless you add a real adapter.
DEEPFAKE_DETECTOR_URL=

# --- Optional SMS delivery ------------------------------------------------
# Configure only after setting up a Twilio account, a permitted sender, and
# recipient consent. Without these values, the app uses manual SMS drafts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Abuse controls -------------------------------------------------------
# In-memory per-process rate limiting for auth, AI, media, and share creation.
RATE_LIMIT_ENABLED=True
